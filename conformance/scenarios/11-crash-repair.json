{
  "name": "crash repair",
  "description": "The session ends in a tool call with no result, as after a crash. The next run gives the call an error result before anything else.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "echo",
      "description": "Echo the text you give it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "behaviour": {
        "echo": "text"
      }
    }
  ],
  "script": [
    {
      "content": [
        {
          "type": "text",
          "text": "Hi."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 10,
        "output": 2
      }
    },
    {
      "content": [
        {
          "type": "text",
          "text": "That call did not run."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 20,
        "output": 5
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Hi"
      }
    },
    {
      "run": {},
      "expect": "idle"
    },
    {
      "crash": {
        "type": "message",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "toolCall",
              "id": "c9",
              "name": "echo",
              "input": {
                "text": "lost"
              }
            }
          ],
          "model": "faux/test",
          "usage": {
            "input": 10,
            "output": 5
          },
          "stop": "toolUse"
        }
      }
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "echo",
              "description": "Echo the text you give it.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            },
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Hi"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Hi."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 2
            },
            "stop": "end"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c9",
                "name": "echo",
                "input": {
                  "text": "lost"
                }
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c9",
            "name": "echo",
            "content": [
              {
                "type": "text",
                "text": "The harness stopped before this tool ran."
              }
            ],
            "isError": true
          }
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "That call did not run."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 20,
              "output": 5
            },
            "stop": "end"
          }
        }
      ]
    ]
  }
}
