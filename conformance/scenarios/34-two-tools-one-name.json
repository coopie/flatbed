{
  "name": "two tools share a name",
  "description": "Two tools are both named echo, so the run fails before it writes anything.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "echo",
      "description": "Echo the text you give it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "behaviour": {
        "echo": "text"
      }
    },
    {
      "name": "echo",
      "description": "Echo the text you give it, again.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "behaviour": {
        "echo": "text"
      }
    }
  ],
  "script": [],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Hi"
      }
    },
    {
      "run": {},
      "expect": {
        "error": "Two tools are named echo."
      }
    }
  ],
  "expect": {
    "sessions": []
  }
}
