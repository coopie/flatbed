                "id": "c1",
                "name": "echo",
                "input": {
                  "text": "one"
                }
              },
              {
                "type": "toolCall",
                "id": "c2",
                "name": "echo",
                "input": {
                  "text": "two"
                }
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
