{
  "name": "concurrent resets take the reason of the first in call order",
  "description": "Two calls request a reset. The second requests it first in time, but the reset entry takes the reason of the first call in call order.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "slow_reset",
      "description": "Wait, then ask for a reset.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "sleep": 200,
        "reset": "first in call order"
      }
    },
    {
      "name": "quick_reset",
      "description": "Ask for a reset at once.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "reset": "first in time"
      }
    }
  ],
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "slow_reset",
          "input": {}
        },
        {
          "type": "toolCall",
          "id": "c2",
          "name": "quick_reset",
          "input": {}
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Reset"
      }
    },
    {
      "run": {},
      "expect": "reset"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "slow_reset",
              "description": "Wait, then ask for a reset.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "quick_reset",
              "description": "Ask for a reset at once.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Reset"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "slow_reset",
                "input": {}
              },
              {
                "type": "toolCall",
                "id": "c2",
                "name": "quick_reset",
                "input": {}
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "slow_reset",
            "content": [
              {
                "type": "text",
                "text": "Session will reset after this turn."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c2",
            "name": "quick_reset",
            "content": [
              {
                "type": "text",
                "text": "Session will reset after this turn."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "reset",
          "by": "agent",
          "reason": "first in call order"
        }
      ]
    ]
  }
}
