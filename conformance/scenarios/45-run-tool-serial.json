{
  "name": "runTool completes when calls are serial",
  "description": "With toolExecution serial, the fanout tool runs two slow calls at once with ctx.runTool. It gives up its place while they run, so they can start, and they still run one at a time. The second direct call starts after fanout has finished.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000,
    "toolExecution": "serial"
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "slow",
      "description": "Wait a while, then say so.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "sleep": 100,
        "text": "Waited."
      }
    },
    {
      "name": "fanout",
      "description": "Run several slow calls of its own at once.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "runTools": [
          {
            "name": "slow",
            "input": {}
          },
          {
            "name": "slow",
            "input": {}
          }
        ]
      }
    }
  ],
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "fanout",
          "input": {}
        },
        {
          "type": "toolCall",
          "id": "c2",
          "name": "slow",
          "input": {}
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    },
    {
      "content": [
        {
          "type": "text",
          "text": "Done."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 20,
        "output": 3
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Fan out, then wait"
      }
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "slow",
              "description": "Wait a while, then say so.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "fanout",
              "description": "Run several slow calls of its own at once.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Fan out, then wait"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "fanout",
                "input": {}
              },
              {
                "type": "toolCall",
                "id": "c2",
                "name": "slow",
                "input": {}
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "fanout",
            "content": [
              {
                "type": "text",
                "text": "Waited.\nWaited."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c2",
            "name": "slow",
            "content": [
              {
                "type": "text",
                "text": "Waited."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Done."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 20,
              "output": 3
            },
            "stop": "end"
          }
        }
      ]
    ],
    "maxRunning": 1
  }
}
