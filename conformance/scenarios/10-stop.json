{
  "name": "stop",
  "description": "The stop signal is set before the run. The loop appends a notice naming who stopped it and does not call the model. A stop notice is from the harness, so the next run with nothing new does not call the model either; once a message is delivered, the model answers it along with everything before it.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [],
  "script": [
    {
      "content": [
        {
          "type": "text",
          "text": "Carrying on."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 10,
        "output": 4
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Start"
      }
    },
    {
      "run": {
        "stop": "Sam"
      },
      "expect": "stopped"
    },
    {
      "run": {},
      "expect": "idle"
    },
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Go on"
      }
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Start"
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Stopped by Sam."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Go on"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Carrying on."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 4
            },
            "stop": "end"
          }
        }
      ]
    ],
    "requests": [
      [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "<notice from=\"harness\">Session started.</notice>"
            },
            {
              "type": "text",
              "text": "<message from=\"Sam\">Start</message>"
            },
            {
              "type": "text",
              "text": "<notice from=\"harness\">Stopped by Sam.</notice>"
            },
            {
              "type": "text",
              "text": "<message from=\"Sam\">Go on</message>"
            }
          ]
        }
      ]
    ]
  }
}
