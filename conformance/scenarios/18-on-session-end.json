{
  "name": "onSessionEnd delivers to the next session",
  "description": "The test plugin's onSessionEnd hook delivers an event when the session resets. The next run opens a new session and delivers the event after its opening notice; since the event is not from the harness, the model answers it without the host delivering anything.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [],
  "plugin": {
    "onSessionEnd": {
      "deliver": {
        "kind": "handover",
        "attrs": {
          "from": "supervisor"
        },
        "text": "Pick up the draft."
      }
    }
  },
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "reset",
          "input": {
            "reason": "done"
          }
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    },
    {
      "content": [
        {
          "type": "text",
          "text": "Picking it up."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 20,
        "output": 3
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Wrap up"
      }
    },
    {
      "run": {},
      "expect": "reset"
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Wrap up"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "reset",
                "input": {
                  "reason": "done"
                }
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "reset",
            "content": [
              {
                "type": "text",
                "text": "Session will reset after this turn."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "reset",
          "by": "agent",
          "reason": "done"
        }
      ],
      [
        {
          "header": {
            "parent": {
              "reason": "reset"
            }
          }
        },
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started after a reset: done"
        },
        {
          "type": "event",
          "kind": "handover",
          "attrs": {
            "from": "supervisor"
          },
          "text": "Pick up the draft."
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Picking it up."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 20,
              "output": 3
            },
            "stop": "end"
          }
        }
      ]
    ],
    "requests": [
      [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "<notice from=\"harness\">Session started.</notice>"
            },
            {
              "type": "text",
              "text": "<message from=\"Sam\">Wrap up</message>"
            }
          ]
        }
      ],
      [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "<notice from=\"harness\">Session started after a reset: done</notice>"
            },
            {
              "type": "text",
              "text": "<handover from=\"supervisor\">Pick up the draft.</handover>"
            }
          ]
        }
      ]
    ]
  }
}
