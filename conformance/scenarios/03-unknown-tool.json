{
  "name": "unknown tool",
  "description": "The model calls a tool the session does not have, and gets an error result naming it.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [],
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "fly",
          "input": {}
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    },
    {
      "content": [
        {
          "type": "text",
          "text": "I cannot fly."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 20,
        "output": 4
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Go"
      }
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Go"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "fly",
                "input": {}
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "fly",
            "content": [
              {
                "type": "text",
                "text": "No tool named fly."
              }
            ],
            "isError": true
          }
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "I cannot fly."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 20,
              "output": 4
            },
            "stop": "end"
          }
        }
      ]
    ]
  }
}
