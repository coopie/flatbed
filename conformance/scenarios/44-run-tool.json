{
  "name": "a tool runs other calls with runTool",
  "description": "The fanout tool runs four calls with ctx.runTool and returns their results, one per line. They pass through the same steps as the model's calls: afterTool replaces echo's result, beforeTool refuses blocked, an unknown name and a missing property get the usual errors. Only fanout's own call gets a tool message.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "echo",
      "description": "Echo the text you give it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "behaviour": {
        "echo": "text"
      }
    },
    {
      "name": "blocked",
      "description": "Do something the guard refuses.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "text": "Ran."
      }
    },
    {
      "name": "fanout",
      "description": "Run several calls of its own.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "runTools": [
          {
            "name": "echo",
            "input": {
              "text": "secret"
            }
          },
          {
            "name": "blocked",
            "input": {}
          },
          {
            "name": "missing",
            "input": {}
          },
          {
            "name": "echo",
            "input": {}
          }
        ]
      }
    }
  ],
  "plugin": {
    "beforeTool": {
      "blocked": {
        "content": [
          {
            "type": "text",
            "text": "Refused."
          }
        ],
        "isError": true
      }
    },
    "afterTool": {
      "echo": {
        "content": [
          {
            "type": "text",
            "text": "[redacted]"
          }
        ],
        "isError": false
      }
    }
  },
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "fanout",
          "input": {}
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    },
    {
      "content": [
        {
          "type": "text",
          "text": "Done."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 20,
        "output": 3
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Fan out"
      }
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "echo",
              "description": "Echo the text you give it.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            },
            {
              "name": "blocked",
              "description": "Do something the guard refuses.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "fanout",
              "description": "Run several calls of its own.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Fan out"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "fanout",
                "input": {}
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "fanout",
            "content": [
              {
                "type": "text",
                "text": "[redacted]\nRefused.\nNo tool named missing.\nInvalid input for echo: missing required property \"text\"."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Done."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 20,
              "output": 3
            },
            "stop": "end"
          }
        }
      ]
    ]
  }
}
