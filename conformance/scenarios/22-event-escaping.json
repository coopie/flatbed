    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [],
  "script": [
    {
      "content": [
        {
          "type": "text",
          "text": "Yes."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 10,
        "output": 1
      }
    }
  ],
  "steps": [
