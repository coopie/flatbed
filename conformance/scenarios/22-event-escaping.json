          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam & \"Jo\"",
            "channel": "<general>",
            "at": "9>8"
          },
          "text": "Is 1 < 2 & \"yes\" > no?"
