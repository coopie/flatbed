{
  "name": "delivery between turns",
  "description": "A tool queues an event while the run is going. The loop delivers it after the turn's results, so the model sees the result and the event together.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "ping",
      "description": "Ask the host to send a message.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "deliver": {
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Pong"
        }
      }
    }
  ],
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "ping",
          "input": {}
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    },
    {
      "content": [
        {
          "type": "text",
          "text": "Pong received."
        }
      ],
      "stop": "end",
      "usage": {
        "input": 20,
        "output": 3
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Ping"
      }
    },
    {
      "run": {},
      "expect": "idle"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "ping",
              "description": "Ask the host to send a message.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Ping"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "ping",
                "input": {}
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "ping",
            "content": [
              {
                "type": "text",
                "text": "Delivered."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Pong"
        },
        {
          "type": "message",
