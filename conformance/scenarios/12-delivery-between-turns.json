            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Pong received."
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 20,
              "output": 3
            },
            "stop": "end"
          }
        }
      ]
