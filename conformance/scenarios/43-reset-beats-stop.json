{
  "name": "a reset wins over a stop set during its turn",
  "description": "A call requests a reset while the host sets the stop. The call finishes, its result and the reset entry are appended with no stop notice, and the run ends with reset.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "wrap_up",
      "description": "Wait, then ask for a reset.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "sleep": 300,
        "reset": "work finished"
      }
    }
  ],
  "script": [
    {
      "content": [
        {
          "type": "toolCall",
          "id": "c1",
          "name": "wrap_up",
          "input": {}
        }
      ],
      "stop": "toolUse",
      "usage": {
        "input": 10,
        "output": 5
      }
    }
  ],
  "steps": [
    {
      "deliver": {
        "kind": "message",
        "attrs": {
          "from": "Sam"
        },
        "text": "Wrap up"
      }
    },
    {
      "run": {
        "stop": "Sam",
        "stopAfter": 100
      },
      "expect": "reset"
    }
  ],
  "expect": {
    "sessions": [
      [
        {
          "type": "context",
          "sections": [
            {
              "name": "soul",
              "text": "You are a test agent."
            }
          ],
          "tools": [
            {
              "name": "wrap_up",
              "description": "Wait, then ask for a reset.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "reset",
              "description": "End this session and start a fresh one. Call it when your notes are up to date and the session is long, or when the work is finished. Anything not written down will be forgotten.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "event",
          "kind": "notice",
          "attrs": {
            "from": "harness"
          },
          "text": "Session started."
        },
        {
          "type": "event",
          "kind": "message",
          "attrs": {
            "from": "Sam"
          },
          "text": "Wrap up"
        },
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "toolCall",
                "id": "c1",
                "name": "wrap_up",
                "input": {}
              }
            ],
            "model": "faux/test",
            "usage": {
              "input": 10,
              "output": 5
            },
            "stop": "toolUse"
          }
        },
        {
          "type": "message",
          "message": {
            "role": "tool",
            "callId": "c1",
            "name": "wrap_up",
            "content": [
              {
                "type": "text",
                "text": "Session will reset after this turn."
              }
            ],
            "isError": false
          }
        },
        {
          "type": "reset",
          "by": "agent",
          "reason": "work finished"
        }
      ]
    ]
  }
}
