{
  "name": "a tool adds tools to the session",
  "description": "connect asks to add weather, a name nobody offers, echo, which the session has, and weather again. Only weather is added, in a new context entry after the turn's results, and the next request carries it. The model calls it, and a second connect adds nothing, so no context entry follows.",
  "agent": {
    "model": "faux/test",
    "softLimit": 120000,
    "hardLimit": 180000
  },
  "sections": [
    {
      "name": "soul",
      "text": "You are a test agent."
    }
  ],
  "tools": [
    {
      "name": "echo",
      "description": "Echo the text you give it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "behaviour": {
        "echo": "text"
      }
    },
    {
      "name": "connect",
      "description": "Connect the weather tools.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "behaviour": {
        "addTools": [
          "weather",
          "missing",
          "echo",
          "weather"
        ]
      }
    }
  ],
  "available": [
    {
      "name": "weather",
      "description": "Say what the weather is.",
      "inputSchema": {
        "type": "object",
