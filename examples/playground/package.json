{
  "name": "@flatbed/playground-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "pnpm run build && node scripts/dev-vars.ts && wrangler dev",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "node --test \"worker/*.test.ts\" \"src/lib/*.test.ts\"",
    "record": "node scripts/record.ts"
  },
  "dependencies": {
    "@flatbed/core": "workspace:*",
    "@flatbed/docs": "workspace:*",
    "@flatbed/supervisor": "workspace:*",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/tinos": "^5.2.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "wrangler": "^4.40.0"
  }
}
